{
  "name": "blinkered",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "play": "tsc --build && node tools/harness/dist/main.js",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm coverage",
    "derive": "tsc --build && node tools/derive/dist/main.js",
    "wordlist": "tsc --build && node tools/wordlist/dist/main.js",
    "dev": "pnpm --filter @blinkered/web dev",
    "build": "tsc --build && pnpm --filter @blinkered/web build"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "fast-check": "^3.23.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.8"
  }
}
