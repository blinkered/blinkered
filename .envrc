# What the local tools talk to: the Postgres `docker compose up` serves.
#
# These have to agree with compose.yaml, which sets POSTGRES_USER=blinkered,
# POSTGRES_PASSWORD=testpass and POSTGRES_DB=blinkered. The password and the database name were
# each in the other's slot for a while, which fails as `password authentication failed` and sends
# you looking at the container rather than at this file.
export BLINKERED_DB_HOST=127.0.0.1
export BLINKERED_DB_PORT=55432
export BLINKERED_DB_TLS=no
export BLINKERED_DB_USER=blinkered
export BLINKERED_DB_PASSWORD=testpass
export BLINKERED_DB_NAME=blinkered
export BLINKERED_DB_SCHEMA=blinkered

# Deliberately absent: anything naming the integration suite's database. That one is pinned to
# `blinkered_test` in apps/server/test/integrationDb.ts rather than read from here, because the
# suite drops and rebuilds its schema and an ambient override pointing it at the line above
# deletes your development data while you have the app open.
